<mvc:View controllerName="com.demo.b72ui5app.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page id="page" title="{i18n>title}">
        <content>
            <Table id="productsTable" items="{/Products}" growing="true" growingThreshold="10" class="sapUiResponsiveContentPadding">
                <headerToolbar>
                    <Toolbar>
                        <Title text="Products" />
                        <ToolbarSpacer />
                        <Button text="Add Product" icon="sap-icon://add" press=".onAddProduct" />
                        <Button text="View Products" press=".onViewProduct" />
                    </Toolbar>
                </headerToolbar>

                <columns>
                    <Column>
                        <Text text="ID" />
                    </Column>

                    <Column>
                        <Text text="Title" />
                    </Column>

                    <Column>
                        <Text text="Price" />
                    </Column>

                    <Column>
                        <Text text="Category" />
                    </Column>

                    <Column>
                        <Text text="Actions" />
                    </Column>
                </columns>

                <items>
                    <ColumnListItem>
                        <cells>
                            <Text text="{id}" />

                            <Text text="{title}" />

                            <Text text="{price}" />

                            <Text text="{category}" />

                            <Button text="View Products" press=".onViewProduct" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
    </Page>
</mvc:View>
