<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form">
    <Dialog id="addProductDialog" title="Add Product" contentWidth="400px" draggable="true">
        <content>
            <f:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="12">
                <Label text="Title" />
                <Input id="inpNewTitle" placeholder="Enter title" />
                <Label text="Price" />
                <Input id="inpNewPrice" type="Number" placeholder="Enter price" />
                <Label text="Category" />
                <Input id="inpNewCategory" placeholder="Enter category" />
            </f:SimpleForm>
        </content>
        <buttons>
            <Button text="Save" type="Emphasized" press=".onSaveNewProduct" />
            <Button text="Cancel" press=".onCancelAddProduct" />
        </buttons>
    </Dialog>
</core:FragmentDefinition>
